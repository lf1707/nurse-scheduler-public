# Core application
APP_NAME="Nurse Scheduler"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-a-long-random-string
JWT_SECRET=change-me-another-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=nurse
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nurse_scheduler
DATABASE_URL=postgresql+asyncpg://nurse_app:change-me-app-password@localhost:5432/nurse_scheduler
APP_DB_USER=nurse_app
APP_DB_PASSWORD=change-me-app-password

# Redis and Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-admin-password
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_EMAIL_IP=5
LOGIN_MAX_FAILURES_PER_IP=20

# Tenant onboarding
TENANT_APPLICATION_AUTO_APPROVE=false
TENANT_APPLICATION_AUTO_PLAN=free
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Nurse Scheduler <no-reply@example.com>"
SMTP_STARTTLS=true

# Scheduling
SOLVER_TIMEOUT_SECONDS=120
SOLVER_NUM_WORKERS=8
SOLVER_MAX_NURSE_DAYS=100000

# Audit export encryption and storage
BACKUP_PASSPHRASE=change-me-audit-export-passphrase
AUDIT_EXPORT_DIR=./audit-exports
OPS_STATE_DIR=./ops-state
AUDIT_RETENTION_DAYS_HOT=180
AUDIT_RETENTION_DAYS_COLD=1095
